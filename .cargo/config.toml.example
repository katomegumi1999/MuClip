# 本文件是模板，不是生效配置。
#
# 真正的 .cargo/config.toml 已被 .gitignore 忽略——因为 NDK 路径是本机绝对路径，
# 提交它会让其他人 clone 后构建失败，也会泄露本机目录结构。
#
# 若你不使用 cargo-ndk（它会自动注入 linker），把本文件复制为 config.toml
# 并把下面的路径改成你自己的 NDK：
#
#     Copy-Item .cargo/config.toml.example .cargo/config.toml
#
# 更推荐的做法是用环境变量，避免任何路径入库：
#
#     $env:CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER = `
#       "$env:ANDROID_NDK_HOME/toolchains/llvm/prebuilt/windows-x86_64/bin/aarch64-linux-android24-clang.cmd"

[target.aarch64-linux-android]
linker = "<你的 NDK 路径>/toolchains/llvm/prebuilt/windows-x86_64/bin/aarch64-linux-android24-clang.cmd"
ar = "<你的 NDK 路径>/toolchains/llvm/prebuilt/windows-x86_64/bin/llvm-ar.exe"
